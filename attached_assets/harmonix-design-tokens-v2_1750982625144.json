    },
    "borderRadius": {
      "none": "0px",
      "sm": "0.125rem",
      "DEFAULT": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem",
      "2xl": "1rem",
      "3xl": "1.5rem",
      "full": "9999px"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "DEFAULT": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
      "2xl": "0 25px 50px -12px rgb(0 0 0 / 0.25)",
      "inner": "inset 0 2px 4px 0 rgb(0 0 0 / 0.05)",
      "glow": "0 0 20px rgb(34 197 94 / 0.3)",
      "glow-lg": "0 0 40px rgb(34 197 94 / 0.4)",
      "lotus": "0 8px 32px rgb(212 175 55 / 0.3)"
    },
    "gradients": {
      "primary": "linear-gradient(135deg, #22c55e 0%, #16a34a 100%)",
      "secondary": "linear-gradient(135deg, #eab308 0%, #ca8a04 100%)",
      "emerald-teal": "linear-gradient(135deg, #10b981 0%, #14b8a6 100%)",
      "jade-gold": "linear-gradient(135deg, #00A86B 0%, #D4AF37 100%)",
      "cosmic": "linear-gradient(135deg, #1E3A8A 0%, #7C3AED 100%)",
      "harmony": "linear-gradient(135deg, #B4FFE3 0%, #00A86B 50%, #D4AF37 100%)",
      "dark": "linear-gradient(135deg, #0F1115 0%, #1e293b 100%)",
      "lotus": "radial-gradient(circle at center, #D4AF37 0%, #B4FFE3 50%, #00A86B 100%)"
    },
    "animations": {
      "durations": {
        "fast": "150ms",
        "normal": "300ms",
        "slow": "500ms",
        "slower": "750ms",
        "slowest": "1000ms"
      },
      "easings": {
        "linear": "linear",
        "ease": "ease",
        "ease-in": "ease-in",
        "ease-out": "ease-out",
        "ease-in-out": "ease-in-out",
        "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
        "smooth": "cubic-bezier(0.4, 0, 0.2, 1)",
        "lotus": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "keyframes": {
        "fade-in": {
          "0%": { "opacity": "0" },
          "100%": { "opacity": "1" }
        },
        "slide-up": {
          "0%": { "transform": "translateY(20px)", "opacity": "0" },
          "100%": { "transform": "translateY(0)", "opacity": "1" }
        },
        "scale-in": {
          "0%": { "transform": "scale(0.95)", "opacity": "0" },
          "100%": { "transform": "scale(1)", "opacity": "1" }
        },
        "lotus-bloom": {
          "0%": { "transform": "scale(0.8) rotate(-5deg)", "opacity": "0.7" },
          "50%": { "transform": "scale(1.05) rotate(2deg)", "opacity": "0.9" },
          "100%": { "transform": "scale(1) rotate(0deg)", "opacity": "1" }
        },
        "harmony-pulse": {
          "0%, 100%": { "box-shadow": "0 0 20px rgba(34, 197, 94, 0.3)" },
          "50%": { "box-shadow": "0 0 40px rgba(34, 197, 94, 0.6)" }
        },
        "agent-glow": {
          "0%, 100%": { "box-shadow": "0 0 15px rgba(212, 175, 55, 0.2)" },
          "50%": { "box-shadow": "0 0 30px rgba(212, 175, 55, 0.5)" }
        }
      }
    },
    "components": {
      "button": {
        "primary": {
          "background": "var(--gradient-jade-gold)",
          "color": "white",
          "padding": "0.75rem 1.5rem",
          "borderRadius": "0.5rem",
          "fontWeight": "600",
          "transition": "all 300ms ease",
          "hover": {
            "transform": "translateY(-2px)",
            "boxShadow": "var(--shadow-glow)"
          }
        },
        "secondary": {
          "background": "transparent",
          "color": "var(--color-brand-lotus-gold)",
          "border": "2px solid var(--color-brand-lotus-gold)",
          "padding": "0.75rem 1.5rem",
          "borderRadius": "0.5rem",
          "fontWeight": "600",
          "transition": "all 300ms ease",
          "hover": {
            "background": "var(--color-brand-lotus-gold)",
            "color": "var(--color-brand-deep-space)"
          }
        }
      },
      "card": {
        "default": {
          "background": "rgba(30, 41, 59, 0.8)",
          "border": "1px solid rgba(148, 163, 184, 0.2)",
          "borderRadius": "1rem",
          "padding": "1.5rem",
          "backdropFilter": "blur(10px)",
          "transition": "all 300ms ease",
          "hover": {
            "borderColor": "var(--color-brand-harmony-jade)",
            "transform": "translateY(-4px)",
            "boxShadow": "var(--shadow-lotus)"
          }
        },
        "agent": {
          "background": "linear-gradient(135deg, rgba(15, 17, 21, 0.9) 0%, rgba(30, 41, 59, 0.8) 100%)",
          "border": "1px solid var(--color-brand-lotus-gold)",
          "borderRadius": "1.5rem",
          "padding": "2rem",
          "position": "relative",
          "overflow": "hidden",
          "hover": {
            "animation": "agent-glow 2s ease-in-out infinite"
          }
        }
      },
      "input": {
        "default": {
          "background": "rgba(30, 41, 59, 0.8)",
          "border": "1px solid rgba(148, 163, 184, 0.3)",
          "borderRadius": "0.5rem",
          "padding": "0.75rem 1rem",
          "color": "white",
          "transition": "all 300ms ease",
          "focus": {
            "borderColor": "var(--color-brand-harmony-jade)",
            "boxShadow": "0 0 0 3px rgba(34, 197, 94, 0.1)"
          }
        }
      },
      "modal": {
        "overlay": {
          "background": "rgba(0, 0, 0, 0.8)",
          "backdropFilter": "blur(4px)",
          "animation": "fade-in 300ms ease"
        },
        "content": {
          "background": "var(--color-brand-deep-space)",
          "border": "1px solid var(--color-brand-lotus-gold)",
          "borderRadius": "1.5rem",
          "padding": "2rem",
          "animation": "scale-in 300ms ease"
        }
      }
    },
    "breakpoints": {
      "xs": "475px",
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },
    "zIndex": {
      "hide": "-1",
      "auto": "auto",
      "base": "0",
      "docked": "10",
      "dropdown": "1000",
      "sticky": "1100",
      "banner": "1200",
      "overlay": "1300",
      "modal": "1400",
      "popover": "1500",
      "skipLink": "1600",
      "toast": "1700",
      "tooltip": "1800"
    },
    "accessibility": {
      "focusRing": {
        "width": "2px",
        "style": "solid",
        "color": "var(--color-brand-harmony-jade)",
        "offset": "2px"
      },
      "contrast": {
        "minimum": "4.5:1",
        "enhanced": "7:1"
      }
    }
  }
}

